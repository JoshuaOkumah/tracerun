# TRACE//RUN web client (Vite exposes only VITE_-prefixed vars).
# Verification server (apps/server). Point this at your deployed server.
VITE_API_URL=http://localhost:8787
# QoreChain network the game signs on, and the public REST used for tx links.
VITE_QORE_CHAIN_ID=qorechain-diana
VITE_QORE_PUBLIC_REST=https://api-testnet.qore.host
# From the create-qorechain-dapp template (Diana testnet).
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=https://api-testnet.qore.host
VITE_QORE_EVM_RPC_URL=https://evm-testnet.qore.host
