# QoreChain endpoints for the web app (Vite exposes only VITE_-prefixed vars).
# The public REST API sends no CORS headers, so the browser reaches it through
# the Vite dev server: requests to /lcd go to QORE_REST_PROXY_TARGET.
# Defaults below point at the Diana testnet.
VITE_QORE_REST_URL=/lcd
QORE_REST_PROXY_TARGET=https://api-testnet.qore.host
VITE_QORE_EVM_RPC_URL=https://evm-testnet.qore.host
