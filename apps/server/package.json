{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TRACE//RUN verification server: issues challenges and sessions, verifies QoreX-signed runs by replaying them, checks anchor transactions, serves the leaderboard.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@qorechain/qoresign": "^0.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "@tracerun/engine": "0.1.0"
  }
}
